---
// Scherenschnitt der Giebelhäuser am Prinzipalmarkt mit Lambertiturm.
// Beim Laden gehen die Fenster nacheinander aus – Münster schläft ein.
type Giebel = 'spitz' | 'stufen' | 'geschwungen';
type Haus = { w: number; h: number; g: Giebel } | 'turm';

const H = 480;
const ARKADE = 70;
const vorne: Haus[] = [
	{ w: 120, h: 250, g: 'spitz' },
	{ w: 140, h: 285, g: 'stufen' },
	{ w: 115, h: 240, g: 'geschwungen' },
	{ w: 135, h: 300, g: 'stufen' },
	{ w: 120, h: 262, g: 'spitz' },
	{ w: 130, h: 276, g: 'geschwungen' },
	'turm',
	{ w: 125, h: 250, g: 'stufen' },
	{ w: 140, h: 290, g: 'geschwungen' },
	{ w: 118, h: 245, g: 'spitz' },
	{ w: 130, h: 270, g: 'stufen' },
];
const TURM_W = 96;
const breite = vorne.reduce((s, h) => s + (h === 'turm' ? TURM_W : h.w), 0);

function giebel(x: number, y0: number, w: number, gh: number, g: Giebel) {
	const yb = y0 + gh;
	if (g === 'spitz') return `M${x},${yb} L${x + w / 2},${y0} L${x + w},${yb} Z`;
	if (g === 'stufen') {
		const s = gh / 4;
		const t = w / 8;
		return [
			`M${x},${yb}`,
			`V${yb - s} H${x + t} V${yb - 2 * s} H${x + 2 * t} V${yb - 3 * s} H${x + 3 * t} V${y0}`,
			`H${x + 5 * t} V${yb - 3 * s} H${x + 6 * t} V${yb - 2 * s} H${x + 7 * t} V${yb - s} H${x + w} V${yb} Z`,
		].join(' ');
	}
	return [
		`M${x},${yb}`,
		`Q${x + w * 0.04},${yb - gh * 0.6} ${x + w * 0.28},${yb - gh * 0.58}`,
		`Q${x + w * 0.36},${y0} ${x + w * 0.5},${y0}`,
		`Q${x + w * 0.64},${y0} ${x + w * 0.72},${yb - gh * 0.58}`,
		`Q${x + w * 0.96},${yb - gh * 0.6} ${x + w},${yb} Z`,
	].join(' ');
}

// Häuser und Fenster berechnen
const haeuser: { pfad: string; korpus: string; boegen: string[] }[] = [];
const fenster: { x: number; y: number; w: number; h: number }[] = [];
let turm = { x: 0 };
let x = (1440 - breite) / 2;
for (const haus of vorne) {
	if (haus === 'turm') {
		turm = { x };
		x += TURM_W;
		continue;
	}
	const { w, h, g } = haus;
	const gh = w * 0.55;
	const y0 = H - h;
	const korpusOben = y0 + gh;
	const boegen: string[] = [];
	const bw = (w - 3 * 10) / 2;
	for (let i = 0; i < 2; i++) {
		const bx = x + 10 + i * (bw + 10);
		const by = H - ARKADE + 14;
		boegen.push(`M${bx},${H} V${by + bw / 2} A${bw / 2},${bw / 2} 0 0 1 ${bx + bw},${by + bw / 2} V${H} Z`);
	}
	haeuser.push({
		pfad: giebel(x, y0, w, gh, g),
		korpus: `M${x},${korpusOben} H${x + w} V${H} H${x} Z`,
		boegen,
	});
	const spalten = w >= 125 ? 3 : 2;
	const fw = 16;
	const fh = 24;
	const abstand = (w - spalten * fw) / (spalten + 1);
	const reihen = Math.floor((H - ARKADE - korpusOben - 16) / 50);
	for (let r = 0; r < reihen; r++) {
		for (let s = 0; s < spalten; s++) {
			fenster.push({
				x: x + abstand + s * (fw + abstand),
				y: H - ARKADE - 40 - r * 50,
				w: fw,
				h: fh,
			});
		}
	}
	// Ein kleines Fenster im Giebel
	fenster.push({ x: x + w / 2 - 7, y: y0 + gh * 0.45, w: 14, h: 20 });
	x += w;
}

// Feste, gemischte Reihenfolge fürs Ausgehen der Lichter
let saat = 7;
const zufall = () => ((saat = (saat * 9301 + 49297) % 233280) / 233280);
const reihenfolge = fenster.map((_, i) => i).sort(() => zufall() - 0.5);
const nummer = new Map(reihenfolge.map((f, i) => [f, i]));

const fensterPfad = (f: (typeof fenster)[number]) =>
	`M${f.x},${f.y + f.h} V${f.y + f.w / 2} A${f.w / 2},${f.w / 2} 0 0 1 ${f.x + f.w},${f.y + f.w / 2} V${f.y + f.h} Z`;

// Hintere Reihe: Dächer und die Domtürme als flache Silhouette
const hinten = [
	'M0,480 V300 L40,262 L80,300 V286 L130,240 L180,286 V310',
	'H230 V180 L270,150 L310,180 V300 H330 V172 L370,142 L410,172 V300',
	'L460,250 L510,300 V270 L560,228 L610,270 V306 L660,262 L700,306',
	'V290 L760,236 L820,290 V310 L880,266 L940,310 V280 L990,238 L1040,280',
	'V300 L1100,250 L1160,300 V286 L1210,246 L1260,286 V306 L1310,262 L1360,306 V290 L1400,260 L1440,290 V480 Z',
].join(' ');

const tx = turm.x;
const tw = TURM_W;
---

<svg
	class="skyline"
	viewBox={`0 0 1440 ${H}`}
	preserveAspectRatio="xMidYMax slice"
	role="img"
	aria-label="Scherenschnitt der Giebelhäuser am Prinzipalmarkt in Münster mit dem Lambertiturm. Die Fenster gehen nacheinander aus."
>
	<path class="hinten" d={hinten}></path>

	<g class="vorne">
		{
			haeuser.map((h) => (
				<g>
					<path class="fassade" d={h.pfad} />
					<path class="fassade" d={h.korpus} />
					{h.boegen.map((b) => (
						<path class="bogen" d={b} />
					))}
				</g>
			))
		}

		<!-- Lambertiturm -->
		<path
			class="fassade"
			d={`M${tx},${H} V150 H${tx + tw} V${H} Z
				M${tx + tw * 0.1},150 V92 H${tx + tw * 0.9} V150 Z
				M${tx + tw * 0.1},92 L${tx + tw / 2},4 L${tx + tw * 0.9},92 Z
				M${tx},150 L${tx + 8},118 L${tx + 16},150 Z
				M${tx + tw - 16},150 L${tx + tw - 8},118 L${tx + tw},150 Z`}
		></path>
		<path
			class="bogen"
			d={[200, 280].flatMap((y) =>
				[0.3, 0.58].map((p) => `M${tx + tw * p},${y + 44} V${y + 6} A6,6 0 0 1 ${tx + tw * p + 12},${y + 6} V${y + 44} Z`)
			).join(' ') + ` M${tx + tw * 0.3},${H} V${H - 40} A${tw * 0.2},${tw * 0.2} 0 0 1 ${tx + tw * 0.7},${H - 40} V${H} Z
				M${tx + tw * 0.25},140 V112 A8,8 0 0 1 ${tx + tw * 0.25 + 16},112 V140 Z
				M${tx + tw * 0.75 - 16},140 V112 A8,8 0 0 1 ${tx + tw * 0.75},112 V140 Z`}
		></path>
		<circle class="ziffernblatt" cx={tx + tw / 2} cy="356" r="17"></circle>
		<path class="zeiger" d={`M${tx + tw / 2},356 V344 M${tx + tw / 2},356 L${tx + tw / 2 + 8},360`}></path>

		{fenster.map((f, i) => <path class="fenster" d={fensterPfad(f)} style={`--n:${nummer.get(i)}`} />)}
	</g>
</svg>

<style>
	.skyline {
		display: block;
		width: 100%;
		height: clamp(15rem, 34vw, 30rem);
	}
	.hinten {
		fill: var(--c-ferne);
	}
	.vorne {
		filter: drop-shadow(-4px -3px 0 var(--c-mondkante));
	}
	.fassade {
		fill: var(--c-fassade);
	}
	.bogen {
		fill: var(--c-schatten);
	}
	.ziffernblatt {
		fill: var(--c-papier);
		stroke: var(--c-schatten);
		stroke-width: 3;
	}
	.zeiger {
		stroke: var(--c-schatten);
		stroke-width: 3;
		stroke-linecap: round;
	}
	.fenster {
		fill: var(--c-abendblau);
	}
	@media (prefers-reduced-motion: no-preference) {
		.fenster {
			animation: licht-aus 0.5s ease-in both;
			animation-delay: calc(1.2s + var(--n) * 55ms);
		}
		@keyframes licht-aus {
			from {
				fill: var(--c-fenster);
			}
			to {
				fill: var(--c-abendblau);
			}
		}
	}
</style>
