---
// Entwurf C „Gute Nacht, Münster“: Scherenschnitt, Bilderbuch, lokal.
import '@fontsource/alegreya-sans/400.css';
import '@fontsource/alegreya-sans/500.css';
import '@fontsource/alegreya-sans/700.css';
import '@fontsource/corben/400.css';
import '@fontsource/corben/700.css';
import { seo } from '@data/inhalt';
import { SEO } from 'astro-seo';
---

<!DOCTYPE html>
<html lang="de">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<SEO title={seo.titel} description={seo.beschreibung} noindex nofollow />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="theme-color" content="#d8d2f6" />
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--c-papier: #f6f4fc;
		--c-abend: #d8d2f6;
		--c-himmel-tief: #a397df;
		--c-nacht: #4b3f86;
		--c-sandstein: #ecd5a2;
		--c-schatten: #4a3f7d;
		--c-fenster: #ffc93d;
		--c-fenster-aus: #6d60ad;
		--c-tinte: #1f3b33;
		--c-tinte-2: #46605a;
		--c-breite: 72rem;
	}
	body {
		background: var(--c-papier);
		color: var(--c-tinte);
		font-family: 'Alegreya Sans', system-ui, sans-serif;
		font-size: 1.1875rem;
		line-height: 1.5;
		-webkit-font-smoothing: antialiased;
	}
	@media (min-width: 768px) {
		body {
			font-size: 1.25rem;
		}
	}
	h1,
	h2 {
		font-family: 'Corben', Georgia, serif;
		font-weight: 700;
		letter-spacing: -0.01em;
		line-height: 1.05;
		text-wrap: balance;
	}
	h3 {
		font-family: 'Corben', Georgia, serif;
		font-weight: 400;
		letter-spacing: normal;
		line-height: 1.2;
	}
	p,
	li {
		text-wrap: pretty;
		letter-spacing: normal;
	}
	a {
		color: var(--c-nacht);
		text-underline-offset: 0.18em;
	}
	:focus-visible {
		outline: 3px solid var(--c-tinte);
		outline-offset: 3px;
		border-radius: 0.25rem;
	}
	html {
		scroll-behavior: smooth;
	}
	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto;
		}
	}
</style>
